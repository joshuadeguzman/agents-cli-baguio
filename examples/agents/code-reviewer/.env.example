# Copy this file to .env, then put your Gemini API key in .env.
#   cp .env.example .env
# .env is in .gitignore. Never commit it, and never paste the key into a chat.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# The git repo the agent reviews. setup.sh creates sample_repo with a branch to review.
REPO_DIR=sample_repo
# To use Gemini on Google Cloud instead of an API key, remove GEMINI_API_KEY and set:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
